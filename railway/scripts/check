#!/usr/bin/env bash
# Offline checks for the Railway image layer. Needs packer; shellcheck is used if present.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/../packer"

echo "--- packer fmt"
packer fmt -check -diff railway-agent-image.pkr.hcl

echo "--- packer validate"
packer init railway-agent-image.pkr.hcl >/dev/null
packer validate railway-agent-image.pkr.hcl

echo "--- bash -n"
for f in build scripts/* conf/agent-prep/railway-agent-prep; do
  bash -n "$f" && echo "  ok  $f"
done

if command -v shellcheck >/dev/null; then
  echo "--- shellcheck"
  shellcheck -S warning build scripts/* conf/agent-prep/railway-agent-prep
fi

if command -v deno >/dev/null; then
  echo "--- deno"
  deno fmt --check conf/low-disk/*.ts
  deno check conf/low-disk/cycle-agent-on-low-disk.ts
  deno test --allow-env conf/low-disk/cycle-agent-on-low-disk_test.ts
else
  echo "--- deno: not installed, skipping fmt/check/test of the low-disk cycler"
fi

echo "ok"
