SCCACHE_START_SERVER=1
SCCACHE_NO_DAEMON=1
SCCACHE_SERVER_UDS=/run/sccache/sccache.sock
SCCACHE_IDLE_TIMEOUT=0
SCCACHE_MULTILEVEL_CHAIN=disk,gcs
SCCACHE_MULTILEVEL_WRITE_ERROR_POLICY=l0
SCCACHE_DIR=/var/lib/sccache
SCCACHE_CACHE_SIZE=20G
SCCACHE_LOCAL_RW_MODE=READ_WRITE
SCCACHE_GCS_BUCKET=railway-rust-sccache
SCCACHE_GCS_KEY_PREFIX=rust/v1
SCCACHE_GCS_RW_MODE=READ_WRITE
SCCACHE_BASEDIRS=/work:/mono:/home
