[Unit]
Description=Cycle the Buildkite agent when its root disk is low

[Service]
Type=oneshot
Environment=DISK_MIN_AVAILABLE_KB=10485760
# Provisional build-pool reserve: observed aggregate usage grew 32.7 GiB
# in 10 minutes; per-job peaks and a safe four-slot budget are still unknown.
Environment=BUILD_QUEUE_DISK_MIN_AVAILABLE_KB=67108864
Environment=DISK_MIN_INODES=250000
ExecStart=/usr/local/bin/deno run --no-config --allow-env=DISK_MIN_AVAILABLE_KB,BUILD_QUEUE_DISK_MIN_AVAILABLE_KB,DISK_MIN_INODES --allow-net=169.254.169.254:80 --allow-read=/etc/buildkite-agent/buildkite-agent.cfg --allow-run=/usr/bin/df,/usr/bin/systemctl /usr/local/lib/railway/cycle-agent-on-low-disk.ts
# Covers the agent's 10 minute stop timeout with room to spare.
TimeoutStartSec=12min
