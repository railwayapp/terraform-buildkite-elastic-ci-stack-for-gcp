#!/usr/bin/env bash
# Build the Railway agent image as a layer on Buildkite's published image.
# Run from anywhere; operates on the directory this script lives in.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

PROJECT_ID="railway-infra"
ZONE="us-west1-a"
MACHINE_TYPE="n2-standard-8"
BUILD_NUMBER="$(date +%Y%m%d-%H%M%S)"
SOURCE_IMAGE=""
IMAGE_FAMILY="buildkite-ci-stack"
SERVICE_ACCOUNT_EMAIL=""

usage() {
  cat <<EOF
Usage: $0 [options]

  -p, --project-id ID        Project to build and publish in (default: $PROJECT_ID)
  -z, --zone ZONE            Builder zone (default: $ZONE)
  -m, --machine-type TYPE    Builder machine type (default: $MACHINE_TYPE)
  -b, --build-number N       Build number (default: timestamp)
  -i, --source-image NAME    Pin an exact upstream image instead of the newest in the family
  -f, --image-family NAME    Family to publish into (default: $IMAGE_FAMILY). Use a test family
                             for a trial build; production instance templates resolve the default.
  -s, --service-account EMAIL
  -h, --help
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -p|--project-id)      PROJECT_ID="$2"; shift 2 ;;
    -z|--zone)            ZONE="$2"; shift 2 ;;
    -m|--machine-type)    MACHINE_TYPE="$2"; shift 2 ;;
    -b|--build-number)    BUILD_NUMBER="$2"; shift 2 ;;
    -i|--source-image)    SOURCE_IMAGE="$2"; shift 2 ;;
    -f|--image-family)    IMAGE_FAMILY="$2"; shift 2 ;;
    -s|--service-account) SERVICE_ACCOUNT_EMAIL="$2"; shift 2 ;;
    -h|--help)            usage; exit 0 ;;
    *) echo "unknown option: $1" >&2; usage; exit 1 ;;
  esac
done

command -v packer >/dev/null || { echo "packer not found" >&2; exit 1; }
command -v gcloud >/dev/null || { echo "gcloud not found" >&2; exit 1; }

echo "project        $PROJECT_ID"
echo "zone           $ZONE"
echo "machine type   $MACHINE_TYPE"
echo "build number   $BUILD_NUMBER"
echo "source image   ${SOURCE_IMAGE:-newest in buildkite-gcp-stack/buildkite-ci-stack-x86-64}"
echo "image family   $IMAGE_FAMILY"

packer init railway-agent-image.pkr.hcl
packer build \
  -var "project_id=$PROJECT_ID" \
  -var "zone=$ZONE" \
  -var "machine_type=$MACHINE_TYPE" \
  -var "build_number=$BUILD_NUMBER" \
  -var "source_image=$SOURCE_IMAGE" \
  -var "image_family=$IMAGE_FAMILY" \
  -var "service_account_email=$SERVICE_ACCOUNT_EMAIL" \
  railway-agent-image.pkr.hcl
