#!/usr/bin/env bash
set -euo pipefail

# Bootstrap script for Buildkite agent VM instances
# This script configures and starts the Buildkite agent on first boot
# It is installed to /usr/local/bin/bootstrap-buildkite-agent during image build

echo "Starting Buildkite agent configuration..."

# Get metadata values from GCP instance metadata
get_metadata() {
    local key="$1"
    local default="${2:-}"
    curl -s -f -H "Metadata-Flavor: Google" \
        "http://metadata.google.internal/computeMetadata/v1/instance/attributes/$key" 2>/dev/null || echo "$default"
}

# Get Buildkite agent token - either directly or from Secret Manager
BUILDKITE_TOKEN=$(get_metadata "buildkite-token")
BUILDKITE_TOKEN_SECRET=$(get_metadata "buildkite-token-secret")

if [[ -n "$BUILDKITE_TOKEN_SECRET" ]]; then
    echo "Fetching Buildkite agent token from Secret Manager..."
    # Use the full resource name directly as the positional argument to gcloud
    # e.g., "projects/my-project/secrets/my-secret/versions/latest"
    BUILDKITE_TOKEN=$(gcloud secrets versions access "$BUILDKITE_TOKEN_SECRET")
fi

if [[ -z "$BUILDKITE_TOKEN" ]]; then
    echo "ERROR: Buildkite agent token not found"
    echo "Please set either buildkite-token or buildkite-token-secret in instance metadata"
    exit 1
fi

# Optional configuration from instance metadata
BUILDKITE_AGENT_NAME=$(get_metadata "buildkite-agent-name" "$(hostname)")
BUILDKITE_QUEUE=$(get_metadata "buildkite-queue" "default")
BUILDKITE_PRIORITY=$(get_metadata "buildkite-priority" "1")
BUILDKITE_TAGS=$(get_metadata "buildkite-tags" "")
BUILDKITE_API_ENDPOINT=$(get_metadata "buildkite-api-endpoint" "")
BUILDKITE_SPAWN=$(get_metadata "buildkite-spawn" "1")
BUILDKITE_GIT_CLONE_MIRROR_FLAGS=$(get_metadata "buildkite-git-clone-mirror-flags" "-v")
BUILDKITE_DOCKERHUB_CACHE_URL=$(get_metadata "buildkite-dockerhub-cache-url" "")

# GCP context (for tags)
PROJECT_ID=$(curl -s -H "Metadata-Flavor: Google" "http://metadata.google.internal/computeMetadata/v1/project/project-id")
ZONE=$(curl -s -H "Metadata-Flavor: Google" "http://metadata.google.internal/computeMetadata/v1/instance/zone" | cut -d'/' -f4)
INSTANCE_NAME=$(curl -s -H "Metadata-Flavor: Google" "http://metadata.google.internal/computeMetadata/v1/instance/name")

# Export variables for envsubst
export BUILDKITE_TOKEN
export BUILDKITE_AGENT_NAME
export BUILDKITE_QUEUE
export BUILDKITE_PRIORITY
export BUILDKITE_TAGS
export BUILDKITE_API_ENDPOINT
export BUILDKITE_SPAWN
export BUILDKITE_GIT_CLONE_MIRROR_FLAGS
export PROJECT_ID
export ZONE
export INSTANCE_NAME

echo "Configuring Buildkite agent with:"
echo "  Name: $BUILDKITE_AGENT_NAME"
echo "  Queue: $BUILDKITE_QUEUE"
echo "  Priority: $BUILDKITE_PRIORITY"
echo "  Tags: $BUILDKITE_TAGS"
echo "  API Endpoint: ${BUILDKITE_API_ENDPOINT:-default}"
echo "  GCP Project: $PROJECT_ID"
echo "  GCP Zone: $ZONE"
echo "  Instance: $INSTANCE_NAME"

# Generate configuration from templates
echo "Generating configuration from templates..."

envsubst < /etc/buildkite-agent/templates/buildkite-agent.cfg.template \
  | sudo tee /etc/buildkite-agent/buildkite-agent.cfg > /dev/null

# Add API endpoint if specified
if [[ -n "$BUILDKITE_API_ENDPOINT" ]]; then
    echo "endpoint=\"$BUILDKITE_API_ENDPOINT\"" | sudo tee -a /etc/buildkite-agent/buildkite-agent.cfg > /dev/null
fi

sudo chown buildkite-agent:buildkite-agent /etc/buildkite-agent/buildkite-agent.cfg
sudo chmod 640 /etc/buildkite-agent/buildkite-agent.cfg

# Generate environment file
envsubst < /etc/buildkite-agent/templates/buildkite-agent-env.template \
  | sudo tee /etc/buildkite-agent/env > /dev/null

sudo chown buildkite-agent:buildkite-agent /etc/buildkite-agent/env
sudo chmod 640 /etc/buildkite-agent/env

# Fix permissions for buildkite agent directories
if [ -x /usr/bin/fix-buildkite-agent-builds-permissions ]; then
  sudo /usr/bin/fix-buildkite-agent-builds-permissions
fi

# Pre-warm the git mirror for the mono repo before the agent starts accepting jobs.
MIRROR_PATH="/var/lib/buildkite-agent/git-mirrors/git-github-com-railwayapp-mono-git"
if [[ ! -d "$MIRROR_PATH" ]]; then
  echo "Pre-warming git mirror for railwayapp/mono..."
  SSH_KEY=$(gcloud secrets versions access latest --secret=private_ssh_key --project="$PROJECT_ID" 2>/dev/null || true)
  if [[ -n "$SSH_KEY" ]]; then
    KEYFILE=$(mktemp)
    echo "$SSH_KEY" > "$KEYFILE"
    chmod 644 "$KEYFILE"
    sudo -u buildkite-agent env "GIT_SSH_COMMAND=ssh -i $KEYFILE -o StrictHostKeyChecking=no" \
      git clone --mirror -v -- git@github.com:railwayapp/mono.git "$MIRROR_PATH" || true
    rm -f "$KEYFILE"
  else
    echo "Warning: No SSH key in Secret Manager, skipping mirror pre-warm"
  fi
  echo "Mirror clone complete"
fi

# Docker Hub authentication, if a `buildkite-dockerhub-token` secret is
# present in this project. The secret value is the raw OAT; the username is
# the `railwaycorp` org. Without this, all agents share the Cloud NAT egress
# IP and the anonymous 100-pulls-per-6h Docker Hub rate limit.
if DH_TOKEN=$(gcloud secrets versions access latest --secret=buildkite-dockerhub-token --project="$PROJECT_ID" 2>/dev/null); then
  DH_AUTH=$(printf 'railwaycorp:%s' "$DH_TOKEN" | base64 -w0)
  sudo -u buildkite-agent mkdir -p /var/lib/buildkite-agent/.docker
  printf '{"auths":{"https://index.docker.io/v1/":{"auth":"%s"}}}\n' "$DH_AUTH" \
    | sudo -u buildkite-agent tee /var/lib/buildkite-agent/.docker/config.json > /dev/null
  sudo chmod 600 /var/lib/buildkite-agent/.docker/config.json
  echo "Configured Docker Hub auth for buildkite-agent (user=railwaycorp)"
else
  echo "No buildkite-dockerhub-token secret in $PROJECT_ID, skipping Docker Hub auth"
fi

# Docker Hub pull-through cache, if a buildkite-dockerhub-cache-url is set
# via instance metadata (e.g. https://us-west1-docker.pkg.dev/PROJECT/dockerhub-cache).
# Merges a registry-mirrors entry into /etc/docker/daemon.json and points
# Docker at gcloud as the AR credential helper, then restarts docker so the
# daemon picks up the mirror before the agent starts accepting jobs.
if [[ -n "$BUILDKITE_DOCKERHUB_CACHE_URL" ]]; then
  echo "Configuring Docker Hub pull-through cache at $BUILDKITE_DOCKERHUB_CACHE_URL"

  CACHE_HOST=${BUILDKITE_DOCKERHUB_CACHE_URL#*://}
  CACHE_HOST=${CACHE_HOST%%/*}

  # Add the gcloud credential helper to the agent's docker config. We can't
  # use `gcloud auth configure-docker` here — it writes to $HOME/.docker/
  # config.json, and `sudo -u buildkite-agent` resolves $HOME from passwd
  # (/home/buildkite-agent), but the running agent has HOME=/var/lib/
  # buildkite-agent set in its systemd unit. So gcloud writes one place
  # and the daemon reads from another. Merge credHelpers directly into the
  # file that already holds the Hub auth.
  AGENT_DOCKER_CFG=/var/lib/buildkite-agent/.docker/config.json
  sudo -u buildkite-agent mkdir -p /var/lib/buildkite-agent/.docker
  if [[ ! -f "$AGENT_DOCKER_CFG" ]]; then
    echo '{}' | sudo -u buildkite-agent tee "$AGENT_DOCKER_CFG" > /dev/null
  fi
  sudo jq --arg host "$CACHE_HOST" '.credHelpers[$host] = "gcloud"' "$AGENT_DOCKER_CFG" \
    | sudo -u buildkite-agent tee "$AGENT_DOCKER_CFG.new" > /dev/null
  sudo mv "$AGENT_DOCKER_CFG.new" "$AGENT_DOCKER_CFG"
  sudo chown buildkite-agent:buildkite-agent "$AGENT_DOCKER_CFG"
  sudo chmod 600 "$AGENT_DOCKER_CFG"

  # Merge registry-mirrors into daemon.json, preserving storage-driver
  # and anything else already configured.
  sudo jq --arg url "$BUILDKITE_DOCKERHUB_CACHE_URL" \
    '. + {"registry-mirrors": [$url]}' /etc/docker/daemon.json \
    | sudo tee /etc/docker/daemon.json.new > /dev/null
  sudo mv /etc/docker/daemon.json.new /etc/docker/daemon.json

  sudo systemctl restart docker
  echo "Restarted docker with registry mirror"
fi

# Enable and start the buildkite-agent service
echo "Starting Buildkite agent service..."
sudo systemctl daemon-reload
sudo systemctl enable buildkite-agent
sudo systemctl start buildkite-agent

# Enable and start preemption monitoring if available
if systemctl list-unit-files | grep -q preemption-monitor; then
  sudo systemctl enable preemption-monitor
  sudo systemctl start preemption-monitor
fi

# Wait a moment for the service to start
sleep 5

# Check if the service started successfully
if sudo systemctl is-active --quiet buildkite-agent; then
    echo "✅ Buildkite agent started successfully"
    sudo systemctl status buildkite-agent --no-pager -l
else
    echo "❌ Failed to start Buildkite agent"
    sudo systemctl status buildkite-agent --no-pager -l
    sudo journalctl -u buildkite-agent --no-pager -n 20
    exit 1
fi

echo "🎉 Buildkite agent configuration complete!"
