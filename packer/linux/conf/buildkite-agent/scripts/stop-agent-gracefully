#!/usr/bin/env bash
set -euo pipefail

# Stop the Buildkite agent, letting it finish whatever job it is running.
#
# systemctl stop is the entire wait. It sends SIGTERM, which tells the agent to
# disconnect once its current job completes, and blocks until the unit is gone
# or TimeoutStopSec expires (10 minutes, from the drop-in installed next to
# this script). There is no agent-side "am I busy" query to poll for, and an
# earlier version of this script polled a metadata key that never existed.
echo "--- Stopping Buildkite agent, waiting for any running job"
sudo systemctl stop buildkite-agent || echo "warning: systemctl stop buildkite-agent failed"
echo "Buildkite agent stopped"
